rules_version = '2';
// Règles de sécurité ADS — à déployer dans la console Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isSuperAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Table des administrateurs : lecture par l'admin concerné, écriture interdite depuis le client.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow write: if false;
    }

    // Données financières : lecture/écriture réservées aux super administrateurs.
    match /{col}/{docId} {
      allow read: if isSuperAdmin()
        || (request.auth != null && resource.data.user_id == request.auth.uid)
        || (request.auth != null && docId == request.auth.uid);
      allow write: if isSuperAdmin();
    }
  }
}
